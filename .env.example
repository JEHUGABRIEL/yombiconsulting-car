# Connexion Postgres (Neon) — à récupérer dans la console Neon, mode « Pooled ».
DATABASE_URL=

# Secret de signature des cookies de session du back-office.
# Générer avec : openssl rand -hex 32 — 32 caractères minimum sont exigés.
SESSION_SECRET=

# Cloudinary — téléversement des images du back-office.
# Cloud name et clé API se lisent dans la console Cloudinary ; le secret ne
# doit jamais être exposé au navigateur ni commité.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
